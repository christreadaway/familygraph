{
  "name": "family-graph",
  "version": "0.1.0",
  "private": true,
  "description": "Local family registry. Source of truth for who is who in a Catholic institution.",
  "license": "Apache-2.0",
  "author": "Chris Treadaway <christreadaway@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/christreadaway/familygraph.git"
  },
  "funding": [
    { "type": "venmo", "url": "https://venmo.com/u/ctreada" }
  ],
  "type": "commonjs",
  "main": "server/index.js",
  "bin": {
    "family-graph": "./bin/family-graph.js"
  },
  "scripts": {
    "preinstall": "node scripts/preinstall-sfw-check.js",
    "start": "node server/index.js",
    "dev": "node -r ./scripts/dev-env.js server/index.js",
    "test": "node --test 'tests/**/*.test.js'",
    "test:single": "node --test",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers npx playwright test",
    "test:e2e:install": "npx playwright install chromium",
    "client:install": "cd client && npm install",
    "client:dev": "cd client && npm run dev",
    "client:build": "cd client && npm run build",
    "rotate-secret": "node bin/family-graph.js rotate-secret",
    "backup": "node bin/family-graph.js backup",
    "restore": "node bin/family-graph.js restore",
    "status": "node bin/family-graph.js status"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "chokidar": "^3.6.0",
    "compromise": "^14.15.0",
    "csv-parse": "^5.5.6",
    "csv-stringify": "^6.5.1",
    "express": "^4.21.0",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1"
  }
}
